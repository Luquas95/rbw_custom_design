#!/bin/bash
# Regeneruje idle složkový pohled (vault se mezitím mohl změnit) a otevře
# walker s provider setem "bitwarden": prázdné pole = jen složky (menus),
# psaní = živé hledání přes celý vault (elephant-bitwarden provider).
set -euo pipefail

# rbw se po lock_timeout odhlašuje sám (a taky si ho může uživatel zamknout/
# odemknout ručně mimo tenhle skript). Běžící elephant-bitwarden provider
# si ale drží vlastní spojení navázané v okamžiku, kdy byl vault naposledy
# zamčený, a po znovu-odemčení se samo neobnoví — živé hledání pak natrvalo
# vrací 0 výsledků, i když `rbw list`/`rbw search` v terminálu fungují.
# Odemčení i restart elephanta dělá bitwarden-generate-menus samo (ať je to
# na jednom místě pro launcher i pro bitwarden-sync).
~/.local/bin/bitwarden-generate-menus

# bitwarden-generate-menus právě restartovalo elephanta (a přes Requires= i
# walker.service). Když walker dostane dotaz dřív, než elephant načte menu,
# spadne na "failed to get item layout: menus:bitwarden-folders" a okno se
# vůbec neotevře. Proto počkat, až elephant menu opravdu vrací (max ~10 s).
for _ in $(seq 1 50); do
    elephant query --json "menus:bitwarden-folders;;1" 2>/dev/null | grep -q '"item"' && break
    sleep 0.2
done
for _ in $(seq 1 50); do
    systemctl --user is-active --quiet walker.service && break
    sleep 0.2
done
sleep 0.5

exec walker -s bitwarden
